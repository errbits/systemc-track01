{
  "name": "ErrBits · SystemC Track 01",
  "image": "ghcr.io/errbits/systemc:2.3.3",
  "postCreateCommand": "make build",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools"],
      "settings": {
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.includePath": ["${workspaceFolder}/include", "/opt/systemc/include"]
      }
    }
  }
}
